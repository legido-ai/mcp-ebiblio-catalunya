# Credentials (required). The generic names win if both are set.
CATALUNYA_EBIBLIO_USERNAME=
CATALUNYA_EBIBLIO_PASSWORD=
# EBIBLIO_USERNAME=
# EBIBLIO_PASSWORD=

# Optional overrides.
# EBIBLIO_BASE_URL=https://biblioteca.ebiblio.cat
# EBIBLIO_DATA_DIR=/data
# EBIBLIO_ADEPT_DIR=/data/.adobe
# EBIBLIO_LIBGOUROU_BIN_DIR=/usr/local/bin
# EBIBLIO_TIMEOUT=120
